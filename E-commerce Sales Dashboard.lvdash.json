      "layout": [
        {
          "widget": {
            "name": "ab5ee22b",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "e71a83fc",
                  "fields": [
                    {
                      "name": "purchase_month",
                      "expression": "`purchase_month`"
